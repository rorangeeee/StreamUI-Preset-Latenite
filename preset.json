{
  "formatVersion": 1,
  "sdkVersion": 2,
  "id": "latenite",
  "name": "LATENITE 多场景",
  "version": "2.2.2",
  "description": "3840 × 2160 双布局，保留弹幕、字标、音频可视化、暂离条带与像素转场。",
  "defaultScene": "ultrawide",
  "defaults": "defaults.json",
  "trayControls": [
    { "label": "暂离模式", "setting": "controls.away" }
  ],
  "scenes": [
    {
      "id": "ultrawide",
      "name": "21:9 · 超宽主画面",
      "view": "21:9",
      "entry": "ui/index.html",
      "width": 3840,
      "height": 2160,
      "runtimeGroup": "overlay",
      "settingsPage": "settings/scene.html",
      "defaults": "defaults/ultrawide.json"
    },
    {
      "id": "fullscreen",
      "name": "16:9 · 全画布叠加",
      "view": "16:9",
      "entry": "ui/index.html",
      "width": 3840,
      "height": 2160,
      "runtimeGroup": "overlay",
      "settingsPage": "settings/scene.html",
      "defaults": "defaults/fullscreen.json"
    },
    {
      "id": "away",
      "name": "暂离",
      "view": "away",
      "entry": "ui/index.html",
      "width": 3840,
      "height": 2160,
      "runtimeGroup": "overlay",
      "settingsPage": "settings/scene.html",
      "defaults": "defaults/away.json",
      "role": "overlay"
    }
  ],
  "plugins": [
    {
      "id": "desktop-audio",
      "minimumVersion": "1.0.3",
      "required": true,
      "repository": "https://github.com/rorangeeee/StreamUI-Plugin-DesktopAudio.git",
      "ref": "1ec6be992498d002d4cfcb40ae128c157dcfc756"
    },
    {
      "id": "system-media",
      "minimumVersion": "1.0.2",
      "required": true,
      "repository": "https://github.com/rorangeeee/StreamUI-Plugin-SystemMedia.git",
      "ref": "81a90f5b355838e30f45ac43d5437d5adf846952"
    },
    {
      "id": "obs-scenes",
      "minimumVersion": "1.0.1",
      "required": true,
      "repository": "https://github.com/rorangeeee/StreamUI-Plugin-ObsScenes.git",
      "ref": "be05ece25af42bc9f58d4511bcbb6a20b1392f44"
    },
    {
      "id": "laplace",
      "minimumVersion": "1.0.1",
      "required": true,
      "repository": "https://github.com/rorangeeee/StreamUI-Plugin-Laplace.git",
      "ref": "b6be5fa5c2009fb2282ec0666f1555fa746a3b70"
    }
  ],
  "repository": "https://github.com/rorangeeee/StreamUI-Preset-Latenite",
  "build": {
    "kind": "vite",
    "output": "ui"
  },
  "sidebarPage": "sidebar.html"
}
